# Deployment on an existing Docker Compose host
SIDINET_IMAGE=ghcr.io/CHANGE_ME/sidinet-dashboard-docker:latest
SIDINET_PORT=8585
SIDINET_DATA_DIR=./data
TZ=America/Mexico_City
SIDINET_LOG_LEVEL=INFO
SIDINET_SAFE_MODE=false
SIDINET_DOCKER_ENABLED=true
SIDINET_PERFORMANCE_PROFILE=balanced
# Run on the Docker host: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
# 0.8.0 shared network/storage providers
SIDINET_HOST_RESOLV_CONF=/host/etc/resolv.conf
SIDINET_INTERNET_TARGET=1.1.1.1:53
# Comma-separated container paths that are mounted read-only below.
SIDINET_STORAGE_PATHS=/data
